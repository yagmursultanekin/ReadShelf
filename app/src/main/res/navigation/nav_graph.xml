<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.readshelf.ui.home.HomeFragment"
        android:label="Ana Sayfa" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.readshelf.ui.search.SearchFragment"
        android:label="Kitap Ara" />

    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.readshelf.ui.library.LibraryFragment"
        android:label="Kitaplığım" />

    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.readshelf.ui.goals.GoalsFragment"
        android:label="Hedeflerim" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.readshelf.ui.settings.SettingsFragment"
        android:label="Ayarlar" />

    <fragment
        android:id="@+id/bookDetailFragment"
        android:name="com.readshelf.ui.detail.BookDetailFragment"
        android:label="Kitap Detayı">
        <argument
            android:name="book_json"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.readshelf.ui.profile.ProfileFragment"
        android:label="Profilim" />

</navigation>